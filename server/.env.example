PORT=5000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DB_PATH=./src/database/pust_guide.db
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Set both only to bootstrap an empty database. Existing accounts are preserved.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional mail delivery endpoint. Receives {to,subject,text}; never returns reset tokens to visitors.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
# Optional AI chat. Keep the key only on the server. Built-in guidance works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
